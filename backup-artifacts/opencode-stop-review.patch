+        self.assertEqual(ops.signalled_pids, [])
+
+        # Trailing data after newline rejected without signalling.
+        trailing = (json.dumps(identity) + "\n" + "{}\n").encode()
+        reply, ops = run_one("stop", trailing)
+        self.assertEqual(reply["event"], "blocked")
+        self.assertEqual(ops.signalled_pids, [])
